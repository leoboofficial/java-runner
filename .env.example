# GEMINI_API_KEY: Optional for AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://leoboofficial.github.io/java-runner"

# VITE_APPS_SCRIPT_URL: Google Apps Script Web App URL (Code.gs headless database endpoint)
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycby80pdcSZeAFDexepQFeUK_ZuNicyao8eqdsDu6gagTT8GpS_-cujgYJR4IJ_b62cgn/exec"

# VITE_RENDER_SERVICE_URL: Render Docker execution runner endpoint
VITE_RENDER_SERVICE_URL="https://java-runner-1zij.onrender.com"

# VITE_API_SECRET: Secret key configured on Render container
VITE_API_SECRET="MY_SECURE_LAB_KEY_123"

# VITE_GOOGLE_CLIENT_ID: (Optional) Google OAuth 2.0 Web Client ID to automatically capture
# the verified Google/Gmail account signed in on the student's device without manual entry.
VITE_GOOGLE_CLIENT_ID=""

