# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# METHOD B ENVIRONMENT CONFIGURATION (Protects backend from student tampering)
# VITE_APPS_SCRIPT_URL: Google Apps Script Web App URL (Code.gs headless database endpoint)
# e.g., https://script.google.com/macros/s/AKfycbx.../exec
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbx.../exec"

# VITE_RENDER_SERVICE_URL: Render Docker execution runner endpoint
# e.g., https://java-runner-xxxx.onrender.com/execute
VITE_RENDER_SERVICE_URL="https://java-runner-xxxx.onrender.com/execute"

# VITE_API_SECRET: Secret key configured on Render container
VITE_API_SECRET="MY_SECURE_LAB_KEY_123"
